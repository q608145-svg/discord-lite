{
  "name": "discord-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Своя копия Discord: серверы, каналы, чат и голосовые комнаты на LiveKit",
  "author": "discord-lite",
  "engines": {
    "node": ">=20"
  },
  "main": "desktop/main.js",
  "scripts": {
    "dev": "npm run build && node server/index.js",
    "build": "prisma generate && next build",
    "start": "node server/index.js",
    "db:push": "prisma db push",
    "db:seed": "node server/seed.js",
    "smoke": "node scripts/smoke.js",
    "check:remote": "node scripts/smoke.js",
    "livekit": "tools/livekit/livekit-server.exe --config infra/livekit.local.yaml",
    "livekit:check": "node scripts/livekit-check.js",
    "livekit:diag": "node scripts/livekit-diag.js",
    "voice:check": "node scripts/voice-e2e.js",
    "pwa:check": "node scripts/pwa-check.js",
    "demo": "node scripts/demo-account.js",
    "icons": "python scripts/make-icons.py",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "desktop:test": "node scripts/desktop-test.js",
    "desktop:build": "node scripts/desktop-build.js",
    "desktop:bake": "node scripts/bake-server.js",
    "desktop:portable": "electron-builder --win portable --config electron-builder.yml"
  },
  "prisma": {
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.22.3",
    "jose": "^5.9.6",
    "livekit-client": "^2.6.2",
    "livekit-server-sdk": "^2.6.1",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "prisma": "^6.1.0",
    "resedit": "^2.0.3",
    "typescript": "^5.7.2"
  }
}
