# Переменные окружения для сервера в интернете (Render).
# Скопируйте в дашборд Render: Environment → Add Environment Variable.
# Этот файл — только шпаргалка, приложение читает обычные переменные окружения.

NODE_ENV=production
NODE_VERSION=22

# Секрет для cookie-сессий: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Neon (direct-хост, обязательно sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# LiveKit Cloud: Settings → Keys + WebSocket URL проекта
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Необязательно: публичный адрес (Render подставляет RENDER_EXTERNAL_URL сам)
# PUBLIC_URL=https://discord-lite-xxxx.onrender.com
