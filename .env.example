# ---- Приложение ----
# JWT-секрет для cookie-сессий. Сгенерируйте свой: openssl rand -hex 32
JWT_SECRET=change-me-please

# Порт приложения
PORT=3000

# ---- База данных ----
# Боевой режим: PostgreSQL (docker compose поднимает его локально).
DATABASE_URL=postgresql://discord:discord@localhost:5432/discord
POSTGRES_PASSWORD=discord

# ---- LiveKit (голос) ----
# Локально: ws://localhost:7880
# На сервере: wss://livekit.вашдомен (браузер требует HTTPS)
# Облако (проще всего): wss://ваш-проект.livekit.cloud + ключи из кабинета
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- Caddy (HTTPS) ----
CHAT_DOMAIN=chat.example.com

# ---- Необязательно: локальный демо-режим без Postgres ----
# Если задать SQLITE_URL, приложение берёт встроенную в Node.js SQLite.
# Удобно, чтобы посмотреть интерфейс на своём ПК: SQLITE_URL=file:./data/dev.db
# SQLITE_URL=
